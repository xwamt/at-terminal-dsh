{
  "name": "@at-series/dsh-at-terminal",
  "version": "0.3.2",
  "type": "module",
  "description": "AT Terminal for DeepSeek Harness: SSH/SFTP assets and remote SSH terminals.",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xwamt/at-terminal-dsh.git",
    "directory": "dsh"
  },
  "homepage": "https://github.com/xwamt/at-terminal-dsh#readme",
  "bugs": {
    "url": "https://github.com/xwamt/at-terminal-dsh/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "ssh",
    "sftp",
    "terminal"
  ],
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./client": "./client.js",
    "./terminal-backend": "./terminal.bundle.js"
  },
  "files": [
    "index.js",
    "tools.js",
    "settings.js",
    "channel.js",
    "commands.js",
    "jobs.js",
    "locale.js",
    "optionalBundle.js",
    "policy.js",
    "prompt.js",
    "skills.js",
    "spill.js",
    "client.js",
    "client.xterm.js",
    "client.styles.js",
    "host.bundle.js",
    "terminal.bundle.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "policy-assets"
  ],
  "engines": {
    "node": ">=24.9",
    "dsh": ">=0.2.1-rc.5 <0.2.2-0 || >=0.2.2-rc.1 <0.3.0-0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0",
    "@deepseek-ai/cosmokit": "1.9.0",
    "ssh2": "^1.16.0"
  },
  "bundledDependencies": [
    "@deepseek-ai/schemastery",
    "@deepseek-ai/cosmokit"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-ui-file-actions"
      ]
    }
  }
}
