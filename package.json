{
  "name": "@at-series/dsh-at-terminal",
  "displayName": "AT Terminal (DSH)",
  "description": "AT Terminal plugin for DeepSeek Harness (DSH): SSH/SFTP assets and remote SSH terminals.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./dsh/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-shortcuts"
      ]
    }
  },
  "scripts": {
    "build": "node dsh/esbuild.dsh.mjs",
    "watch": "node dsh/esbuild.dsh.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "copy:policy-assets": "node scripts/copy-policy-assets.mjs",
    "verify:dsh": "node dsh/esbuild.dsh.mjs --check && node dsh/scripts/verify.mjs",
    "vendor:dsh": "node dsh/scripts/vendor.mjs",
    "dsh:channel:probe": "node dsh/scripts/probe-channel.mjs",
    "build:dsh": "node dsh/esbuild.dsh.mjs"
  },
  "dependencies": {
    "@at-series/command-policy": "0.1.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "ssh2": "^1.16.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/ssh2": "^1.15.5",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
